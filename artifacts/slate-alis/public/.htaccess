# Client-side routing: serve index.html for any path that is not a real file.
# /api is left alone so API calls fail with a real 404 instead of silently
# returning the SPA HTML with a 200.
RewriteEngine On
RewriteBase /
RewriteRule ^api(/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Block HTTP access to dotfiles such as the deploy sync state (FTP still reads it).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
